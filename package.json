{
  "name": "vite-plugin-mjml-to-html",
  "version": "0.1.0",
  "description": "Vite plugin that compiles MJML email templates to static HTML files next to the bundle",
  "keywords": [
    "vite",
    "vite-plugin",
    "mjml",
    "html",
    "email",
    "templates",
    "newsletter"
  ],
  "license": "MIT",
  "author": "Vadim Safonov",
  "homepage": "https://github.com/imamatory/vite-plugin-mjml-to-html#readme",
  "bugs": "https://github.com/imamatory/vite-plugin-mjml-to-html/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imamatory/vite-plugin-mjml-to-html.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm pack --dry-run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "mjml": "^4.18.0 || ^5.0.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mjml": "^5.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.14.0"
}
