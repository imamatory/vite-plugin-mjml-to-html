{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 5am on monday"] },
  "packageRules": [
    { "matchDepTypes": ["devDependencies"], "groupName": "dev dependencies", "automerge": false },
    { "description": "mjml4 is the mjml 4 leg of the CI matrix", "matchDepNames": ["mjml4"], "allowedVersions": "<5" }
  ],
  "mise": { "enabled": true }
}
